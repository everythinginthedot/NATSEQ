manifest {
    name        = 'everythinginthedot/NATSEQ'
    description = 'A Nextflow pipeline for identification of natural antisense transcripts from long-read RNA-seq data'
    author      = 'Artemi Aleshkevich'
    version     = '1.0'
}

/*
 * default params
 */



conda.enabled = true
conda.createOptions = '--channel-priority flexible'
singularity.enabled = false




params {

    // default parameters for INPUT and OUTPUT files
    outdir               = "results"
    genome               = "${projectDir}/data/ref/GRCh38.primary_assembly.genome.fa.gz" // MUST BE ZIPPED USING "BGZIP"
    annotation           = "${projectDir}/data/gtf/gencode.v49.annotation.gtf"
    annotation_classif   = "${projectDir}/data/gtf/ref_qc_classification.txt"



    ///////////////////////////////////////
    // PARAMETERS SKIPPING SUBWORKFLOWS
    ///////////////////////////////////////
    skip_long_preprocessing  = false
    skip_short_preprocessing = false
    skip_aligning_minimap2   = false
    skip_aligning_star       = false
    skip_transcriptome_flair = false


    ///////////////////////////////////////
    // PARAMETERS FOR PREPROCESS_LONG_READS
    ///////////////////////////////////////

    adaptertrimming_tool     = 'porechop'   // fallback for any library_type other than the three below
    // Picked per-sample from meta.library_type (see preprocess_long_reads/main.nf),
    // not one global switch — a samplesheet can mix dRNA/cDNA/direct-cDNA safely.
    // Pychopper also reorients reads to the correct strand by primer identification,
    // which porechop does not do — matters for a strand-specific antisense pipeline.
    adaptertrimming_tool_drna       = 'porechop'
    adaptertrimming_tool_cdna       = 'pychopper'
    adaptertrimming_tool_directcdna = 'pychopper'
    filtering_tool           = 'chopper'


    // default parameters for FILTLONG process
    filtlong_min_length      = 200
    filtlong_args            = ""           // free-form extra args


    // NanoFilt arguments
    nanofilt_length          = 200          // --length
    nanofilt_quality         = 7            // -q (min mean quality)
    nanofilt_maxlength       = null         // --maxlength (optional)
    nanofilt_args            = ""           // free-form extra args


    // Chopper arguments
    chopper_length           = 100          // --length
    chopper_quality          = 4            // -q (min mean quality)
    chopper_args             = ""           // free-form extra args


    // defualt parameters for PORECHOP_ABI process
    custom_adapters_porechop = []
    

    // defualt parameters for SEQTK_SPLIT2 process
    max_monolith_size        = '6.GB'  // files under this threshold are processed whole
    target_chunk_size        = '5.GB'  // target size per chunk when splitting
    split_args               = ''


    // defualt parameters for PYCHOPPER process
    pychopper_min_quality    = 4
    pychoper_primer_kit      = "PCS109"      // same "109" SSP/VNP primer set for cDNA (SQK-PCS109) and direct-cDNA (SQK-DCS109) — verified against SG-NEx's real kits and pychopper's own bundled primer data, no separate -k value exists for direct-cDNA
    pychopper_rescue_directcdna = "DCS109"   // -x, protocol-specific rescue pass — only applied for direct-cDNA samples (see withName: PYCHOPPER in this file)
    pychopper_report_name    = "report_pychopper.pdf"
    pychopper_args           = ""




    ///////////////////////////////////////
    // PARAMETERS FOR PREPROCESS_SHORT_READS
    ///////////////////////////////////////


    skip_clipping            = false
    clip_tool                = "fastp"
    fastp_save_trimmed_fail  = false




    ///////////////////////////////////////
    // PARAMETERS FOR MINIMAP2 
    ///////////////////////////////////////

    // defualt parameters for MINIMAP2_ALIGN process
    cigar_paf_format         = true
    cigar_bam                = true

    minimap2_max_monolith_size        = '6.GB' 
    minimap2_target_chunk_size        = '5.GB' 
    minimap2_split_args      = ''

    minimap2_drna_preset     = "-ax splice -k14 -uf -s 40 -G 350k --MD"
    minimap2_cdna_preset     = "-ax splice -s 40 -G 350k --MD"
    minimap2_d_cdna_preset   = "-ax splice -s 40 -G 350k --MD"


    // defualt parameters for FLAIR process
    junction_support         = 2
    f_combine_filter         = "none"
    flair_extra_args         = ""



    // defualt parameters for FLAIR_COMBINE process
    f_combine_convert_gtf    = true
    f_combine_include_se     = false
    f_combine_args           = ''    // -p MINPERCENTUSAGE / --filter FILTER / --endwindow ENDWINDOW


    // defualt parameters for STAR process
    star_index               = ''   // empty by default — STAR_GENOMEGENERATE builds the index from --genome/--annotation when unset
    star_ignore_sjdbgtf      = false
    star_read_files_command  = 'zcat'


    // defualt parameters for SQANTI_QC process
    sqanti_skip_orf          = true
}



// No named sample-selection profiles here — the six that used to live in this
// file (test_diab/test_gold/test_sgnex/diab/deme/sgnex) were removed: three
// pointed at TEST/ samplesheets with a schema that predates the current input
// format, and three pointed at hardcoded paths on a different machine. See
// REMOVED_UNUSED_CODE.md for the full record. Pass --input explicitly instead.



// Executor task limit
// 70% of this host's 64 CPU / 512 GB (44.8 CPU / 358.4 GB), rounded down for headroom.
executor {
    name      = 'local'
    cpus      = 44
    memory    = '350 GB'
}





process {
    executor = 'local'

    // 1. Default for small utilities (Samtools, Seqkit, NanoPlot)
    cpus   = 2
    memory = '8 GB'

    // 2. HEAVY: alignment and indexing (Minimap2, STAR) — need both cores and memory.
    withName: 'MINIMAP2_ALIGN|STAR_ALIGN|MINIMAP2_INDEX' {
        cpus   = 10      // allows 2 of these to run in parallel
        memory = '40 GB' // 2 processes = 80 GB, leaving 20 GB for the system
    }

    // 2b. Splitting large fastqs into chunks (SeqKit split2, pre- and post-alignment).
    // Sized up from the small-utility default (2 CPU / 8 GB), which was fine for
    // simulated chr1 files (a couple GB) but noticeably slow for real SG-NEx
    // cDNA/direct-cDNA (12-26.5 GB compressed each). maxForks=4 below already caps
    // parallelism here, so this stays well within the executor ceiling
    // (44 CPU / 350 GB): 4 x 8 CPU = 32 CPU, 4 x 24 GB = 96 GB.
    withName: 'SEQKIT_SPLIT2|SEQKIT_SPLIT2_MINIMAP2' {
        cpus   = 8
        memory = '24 GB'
    }

    // 3. MEDIUM: trimming and filtering (Porechop, Chopper, Pychopper) —
    // parallelize well, don't need much memory.
    withName: 'PORECHOP|PORECHOP_ABI|PYCHOPPER|CHOPPER' {
        cpus   = 6
        memory = '16 GB'
    }

    // 4. SPECIFIC: FLAIR and SQANTI3 — often single-threaded or poor at using many
    // cores, but can spike in memory on large GTFs.
    withName: 'FLAIR|FLAIR_COMBINE|FLAIR_QUANTIFY|SQANTI3_QC' {
        cpus   = 4
        memory = '32 GB'
    }

    // Cap concurrent tasks of one type, so chunked Porechop doesn't crowd out
    // everything else.
    withName: 'PORECHOP|SEQKIT_SPLIT2' {
        maxForks = 4
    }







    // NANOPLOT SUBWORKFLOW

    withName: NANOPLOT_BEFORE{
        ext.args = [
            '--N50',
            '--loglength',
            '--plots hex dot',
            '--no_static'
        ].join(' ')
        publishDir = [
            path: { "${params.outdir}/nanoplot/before/${meta.id}" },
            mode: "link"
        ]
    } 


    withName: SEQKIT_SPLIT2 {
        ext.args = {
            [
                "--by-part ${meta.split_chunks}",
                params.split_args ?: ""
            ].join(" ").trim()
        }
    }


    withName: FASTQ_CONCAT {
        publishDir = [
            path: "${params.outdir}/fastq/trimmed",
            mode: "symlink"
        ]
    } 


    withName: PORECHOP {
        publishDir = [
            enabled: false   // intermediate chunks aren't published
        ]
        ext.prefix = { "${meta.id}_porechop" }
        // e.g. SRR30264742_part001_porechop, SRR30264742_part002_porechop — unique per chunk
    }


    withName: PORECHOP_ABI{
        publishDir = [
            path: "${params.outdir}/fastq/trimmed",
            mode: "symlink"
        ]
        ext.prefix = { "${meta.id}_porechop_abi" }
    }  


    withName: PYCHOPPER{
        publishDir = [
            path: "${params.outdir}/fastq/trimmed",
            mode: "link"
        ]
        ext.args = {
            def args_list = [
                "-Q ${params.pychopper_min_quality}",
                "-k ${params.pychoper_primer_kit}",
                "-r ${params.pychopper_report_name}"
            ]
            // -k (primer kit) is the same "109"-generation SSP/VNP primer set for
            // both cDNA and direct-cDNA (SQK-PCS109 / SQK-DCS109 share it — verified
            // against SG-NEx's actual kits and pychopper's own bundled primer data,
            // no separate DCS109 entry exists for -k). -x is different: a protocol-
            // specific *rescue* pass tailored to direct-cDNA reads specifically, only
            // meaningful for that library type — PYCHOPPER now handles both cDNA and
            // direct-cDNA samples (routed here from preprocess_long_reads/main.nf),
            // so this has to be conditional on meta.library_type, not a blanket arg.
            if (meta.library_type == 'direct-cDNA') {
                args_list.add("-x ${params.pychopper_rescue_directcdna}")
            }
            args_list.add(params.pychopper_args ?: "")
            args_list.join(" ").trim()
        }
    }


    withName: FILTLONG {
        publishDir = [
            path: "${params.outdir}/fastq/clean",
            mode: "symlink"
        ]
        ext.prefix = { "${meta.id}_filtlong" }
        ext.args = {
            [
                "--min_length ${params.filtlong_min_length}",
                params.filtlong_args ?: ""
            ].join(" ").trim()
        }
    } 


    withName: NANOFILT {
        publishDir = [
            path: "${params.outdir}/fastq/clean",
            mode: "symlink"
        ]
        ext.prefix = { "${meta.id}_nanofilt" }
        ext.args = {
            [
                "--length ${params.nanofilt_length}",
                "-q ${params.nanofilt_quality}",
                params.nanofilt_maxlength ? "--maxlength ${params.nanofilt_maxlength}" : "",
                params.nanofilt_args ?: ""
            ].join(" ").trim()
        }
    }


    withName: CHOPPER {
        publishDir = [
            path: "${params.outdir}/fastq/clean",
            mode: "symlink"
        ]
        ext.prefix = { "${meta.id}_chopper" }

        // ext.args  → goes to zcat    (leave alone)
        // ext.args2 → goes to chopper ← this is the one to set!
        // ext.args3 → goes to gzip    (leave alone)

        ext.args2 = {
            [
                "-l ${params.chopper_length}",
                "-q ${params.chopper_quality}",
                params.chopper_args ?: ""
            ].join(" ").trim()
        }
    }


    withName: NANOPLOT_AFTER{
        ext.args = [
            '--N50',
            '--loglength',
            '--plots hex dot',
            '--no_static'
        ].join(' ')
        publishDir = [
            path: { "${params.outdir}/nanoplot/after/${meta.id}" },
            mode: "copy"
        ]
    }



    // MINIMAP2 SUBWORKFLOW


    withName: MINIMAP2_INDEX{
        publishDir = [
            path: "data/ref",
            mode: "link"
        ]
    }




    withName: SEQKIT_SPLIT2_MINIMAP2 {
        ext.args = {
            [
                "--by-part ${meta.minimap2_split_chunks}",
                params.minimap2_split_args ?: ""
            ].join(" ").trim()
        }
    }


    withName: MINIMAP2_ALIGN{
        ext.args = {
            def library_type = meta.library_type?.trim()

            if (library_type == 'dRNA') {
                return params.minimap2_drna_preset
            }

            if (library_type == 'cDNA') {
                return params.minimap2_cdna_preset
            }

            if (library_type == 'direct-cDNA') {
                return params.minimap2_d_cdna_preset
            }

            throw new IllegalArgumentException(
                "Unsupported library_type for MINIMAP2_ALIGN: '${meta.library_type}' in sample '${meta.id}'. Expected one of: dRNA, cDNA, direct-cDNA"
        )}
        
        publishDir = [
            path: { "${params.outdir}/bam/${meta.id}" },
            mode: "link"
        ]
    }

    withName: SAMTOOLS_MERGE{
        publishDir = [
            path: { "${params.outdir}/bam/${meta.id}" },
            mode: "link"
        ]
    }

    withName: SAMTOOLS_INDEX{
        publishDir = [
            path: { "${params.outdir}/bam/${meta.id}" },
            mode: "link"
        ]
    }


    // INTRONPROSPECTOR_FLAIR SUBWORKFLOW



    withName: SAMTOOLS_FAIDX{
        publishDir = [
            path: "data/ref",
            mode: "copy"
        ]
    }


    withName: INTRONPROSPECTOR{
        publishDir = [
            path: "${params.outdir}/intron_junctions/",
            mode: "link"
        ]
    }


    withName: STAR_ALIGN{
        publishDir = [
            path: "${params.outdir}/bam/",
            mode: "link"
        ]
        ext.args = {
            [
                "--readFilesCommand ${params.star_read_files_command}"
            ].join(" ").trim()
        }
    }


    withName: FLAIR{
        publishDir = [
            path: { "${params.outdir}/flair/${meta.id}" },
            mode: "link"
        ]
        ext.args = {
            [
                "--junction_support ${params.junction_support}",
                params.flair_extra_args
            ].join(" ").trim()
        }
    }


    withName: FLAIR_COMBINE{
        publishDir = [
            path: { "${params.outdir}/flair/COMBINED/${meta.group_id}" },
            mode: "link"
        ]
        ext.args = {
            def args_list = []

            // boolean flags
            if (params.f_combine_convert_gtf) args_list.add("--convert_gtf")
            if (params.f_combine_include_se)  args_list.add("--include_se")
            if (params.f_combine_filter)      args_list.add("--filter ${params.f_combine_filter}")


            // free-form extra args
            if (params.f_combine_args)        args_list.add(params.f_combine_args)
            
            return args_list.join(" ").trim()
        }
    }


    withName: FLAIR_QUANTIFY{
        publishDir = [
            path: { "${params.outdir}/flair/QUANTIFIED/${meta.group_id}" },
            mode: "link"
        ]
    }


    withName: 'SQANTI3_QC'{
        publishDir = [
            path: { "${params.outdir}/sqanti/qc/" },
            mode: "link"
        ]
        ext.args = {
            def args_list = ["-t ${task.cpus}"]

            // boolean flags
            if (params.sqanti_skip_orf)       args_list.add("--skipORF")

            // The HTML report (SQANTI3_report.Rmd) is fragile — fails on ggplotly()/
            // merge() (a ggplot2/plotly version mismatch) on some inputs, and on
            // small inputs specifically its filter-report sibling can hit a
            // pivot_wider() edge case (see withName: 'SQANTI3_FILTER' below) — either
            // way it's a `sys.exit(1)` inside sqanti3_qc.py's own report step, which
            // kills the whole task. Nothing downstream uses the report (only
            // classification.txt/gtf/fasta, written before the report step), so skip
            // it outright rather than risk the crash.
            args_list.add("--report skip")

            return args_list.join(" ").trim()
        }
    }


    // Heaviest step of all — classifies the whole GENCODE reference (500k+
    // transcripts) against itself. Sized up from the small-utility default
    // (2 CPU / 8 GB), which badly under-provisions a job this size.
    withName: 'SQANTI3_QC_REF' {
        cpus       = 12
        memory     = '64 GB'
        ext.prefix = { "${meta.id}_sqanti_ref" }
        // --report skip: same fragile-report crash risk as withName: 'SQANTI3_QC' above
        ext.args   = { "--force_id_ignore -t ${task.cpus} --report skip" }
        publishDir = [
            path: "${params.outdir}/sqanti/qc_ref/",
            mode: "link"
        ]
    }


    withName: 'SQANTI3_FILTER'{
        cpus   = 4
        memory = '16 GB'
        // --skip_report: SQANTI3_filter_report.R crashes (sys.exit(1), killing the
        // whole task) on small inputs where no isoform fails every filter rule —
        // pivot_wider() then never creates the all_artifacts_TRUE column its own
        // plotting code unconditionally selects. Nothing downstream needs the
        // report — classification/inclusion-list/filtered gtf are all written
        // before this step runs.
        ext.args = { "-c ${task.cpus} --skip_report" }
        publishDir = [
            path: { "${params.outdir}/sqanti/filter/" },
            mode: "link"
        ]
    }


    withName: 'SQANTI3_RESCUE'{
        cpus   = 6
        memory = '32 GB'
        ext.args = { "-c ${task.cpus}" }
        publishDir = [
            path: { "${params.outdir}/sqanti/rescue/" },
            mode: "link"
        ]
    }
  
    
    withName: 'AGAT_CONVERTSPGXF2GXF'{
        publishDir = [
            path: { "${params.outdir}/agat/" },
            mode: "link"
        ]
    }


    withName: 'FIND_OVERLAP'{
        publishDir = [
            path: { "${params.outdir}/overlap/" },
            mode: "link"
        ]
    }
}
